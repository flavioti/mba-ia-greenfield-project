# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Storage (SeaweedFS, S3-compatible)
STORAGE_ENDPOINT=http://seaweedfs:8333
STORAGE_BUCKET=streamtube
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_TTL_SECONDS=3600
STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_CORS_ALLOWED_ORIGINS=http://localhost:3001

# Queue (Redis/Valkey for BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Videos
VIDEO_WORKER_CONCURRENCY=1
UPLOAD_ABANDON_AFTER_HOURS=24
VIDEO_PUBLIC_BASE_URL=http://localhost:3001
